# Скопируйте в .env и поправьте под себя. .env не коммитится.
ENV=local

POSTGRES_USER=perfectday
POSTGRES_PASSWORD=perfectday
POSTGRES_DB=perfectday

DATABASE_URL=postgresql+asyncpg://perfectday:perfectday@localhost:5432/perfectday

REDIS_PASSWORD=
