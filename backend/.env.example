# Скопируйте в .env и поправьте под себя. .env не коммитится.
ENV=local
DEBUG=false

CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_USER=perfectday
POSTGRES_PASSWORD=perfectday
POSTGRES_DB=perfectday

DATABASE_URL=postgresql+asyncpg://perfectday:perfectday@localhost:5432/perfectday

REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379
REDIS_CACHE_DB=0
REDIS_BROKER_DB=1
REDIS_RESULT_DB=2

JWT_SECRET=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MIN=60

FRONTEND_URL=http://localhost:5173
REFRESH_COOKIE_SECURE=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL_TLS=false
